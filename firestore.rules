rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Begeleider (P13): leesrecht op de data van een cliënt enkel als diens
    // uid in `coachUids` op het gebruikersdocument van die cliënt staat. De
    // toegang wordt dus altijd door de cliënt verleend, nooit door de
    // begeleider zelf. Uitdrukkelijk alleen-lezen: een begeleider schrijft
    // nergens in andermans data.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Leesrecht vereist twee dingen tegelijk (P15): de cliënt gaf toegang
    // (`coachUids`), en de rol is actief. Wie de rol verliest, verliest de
    // toegang bij elke cliënt meteen.
    function isCoachOf(uid) {
      let clientDoc = /databases/$(database)/documents/users/$(uid);
      return request.auth != null
        && exists(clientDoc)
        && request.auth.uid in get(clientDoc).data.get('coachUids', [])
        && hasActiveCoachRole(request.auth.uid);
    }

    // Admin (Thomas): `admins/{uid}`, met de hand aangemaakt in de console.
    // Maakt uitnodigingen voor begeleiders.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Actieve begeleidersrol: `coaches/{uid}` bestaat en is niet ingetrokken
    // (`revokedAt`, gezet door de admin). Een ingetrokken document blijft
    // bestaan, zodat de app weet dat dit account begeleider was.
    function hasActiveCoachRole(uid) {
      let roleDoc = /databases/$(database)/documents/coaches/$(uid);
      return exists(roleDoc) && !('revokedAt' in get(roleDoc).data);
    }

    // Begeleider: actieve rol (via een begeleidersuitnodiging), of admin.
    function isCoach() {
      return request.auth != null
        && (hasActiveCoachRole(request.auth.uid) || isAdmin());
    }

    // De aangemelde gebruiker gaf deze begeleider zelf toegang.
    function isClientOf(coachUid) {
      let ownDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null
        && exists(ownDoc)
        && coachUid in get(ownDoc).data.get('coachUids', []);
    }

    // Het gebruikersdocument zelf.
    match /users/{uid} {
      allow read: if isOwner(uid) || isCoachOf(uid);
      allow write: if isOwner(uid);
    }

    // Alles eronder (sessies, entries, instellingen), behalve de
    // toestemmingsrecords, die hieronder hun eigen, strengere regels hebben.
    match /users/{uid}/{coll}/{document=**} {
      allow read: if coll != 'consents' && (isOwner(uid) || isCoachOf(uid));
      allow write: if coll != 'consents' && isOwner(uid);
    }

    // Toestemmingsrecords (P16): bewijs van wie waarmee akkoord ging, met de
    // tekst zoals ze er toen stond. Aanmaken door de eigenaar, één keer
    // intrekken, nooit wijzigen of wissen vanuit de app. Enkel de eigenaar
    // leest ze. Wissen gebeurt enkel bij het verwijderen van het account
    // (P18, Admin SDK, buiten deze regels).
    match /users/{uid}/consents/{consentId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['kind', 'targetUid', 'textVersion', 'text', 'grantedAt', 'withdrawnAt'])
        && request.resource.data.kind in ['begeleiding', 'analyse']
        && request.resource.data.targetUid is string
        && request.resource.data.textVersion is string
        && request.resource.data.text is string
        && request.resource.data.grantedAt == request.time
        && request.resource.data.withdrawnAt == null;
      allow update: if isOwner(uid)
        && resource.data.withdrawnAt == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['withdrawnAt'])
        && request.resource.data.withdrawnAt == request.time;
      allow delete: if false;
    }

    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow write: if false;
    }

    // Rol en naam van een begeleider. Ontstaat enkel samen met het verbruiken
    // van een geldige begeleidersuitnodiging, behalve voor de admin. Daarna
    // kan enkel de naam nog wijzigen. Een cliënt mag de naam lezen van een
    // begeleider aan wie hij zelf toegang gaf.
    match /coaches/{uid} {
      allow get: if isOwner(uid) || isAdmin() || isClientOf(uid);
      allow list: if isAdmin();
      allow create: if isOwner(uid) && (
        (isAdmin() && request.resource.data.keys().hasOnly(['name']))
        || (
          request.resource.data.keys().hasOnly(['name', 'inviteCode', 'createdAt'])
          && get(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteCode)).data.usedBy == null
          && request.time < get(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteCode)).data.expiresAt
          && getAfter(/databases/$(database)/documents/coachInvites/$(request.resource.data.inviteCode)).data.usedBy == uid
        )
      );
      // De begeleider wijzigt enkel de eigen naam, de admin enkel het
      // intrekken en teruggeven van de rol.
      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        || (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt']));
      allow delete: if isAdmin();
    }

    // Begeleidersuitnodigingen: enkel de admin maakt ze. Opvragen per code
    // zonder account, een lijst enkel voor de admin (beheer, P15). Verbruiken kan één keer, voor de
    // vervaldatum, en enkel samen met het aanmaken van `coaches/{uid}`.
    match /coachInvites/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.usedBy == null;
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.time < resource.data.expiresAt
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
        && existsAfter(/databases/$(database)/documents/coaches/$(request.auth.uid));
      allow delete: if isAdmin();
    }

    // Uitnodigingen: een begeleider maakt ze voor zichzelf. Opvragen per code
    // mag zonder account (de uitnodigingspagina toont wie uitnodigt), een
    // lijst opvragen nooit. Verbruiken kan één keer, door een aangemelde
    // gebruiker, voor de vervaldatum, en verandert niets anders.
    match /invites/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isCoach()
        && request.resource.data.coachUid == request.auth.uid
        && request.resource.data.usedBy == null;
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.time < resource.data.expiresAt
        && resource.data.coachUid != request.auth.uid
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']);
      allow delete: if request.auth != null && resource.data.coachUid == request.auth.uid;
    }

    // Koppelingen: enkel zodat de begeleider zijn cliënten kan oplijsten. Ze
    // geven zelf geen leesrecht, dat komt enkel uit `coachUids` hierboven.
    // Aanmaken kan enkel de cliënt, met een geldige, onverbruikte uitnodiging
    // van precies die begeleider, die in dezelfde batch verbruikt wordt.
    match /links/{linkId} {
      allow read: if request.auth != null
        && (resource.data.coachUid == request.auth.uid || resource.data.clientUid == request.auth.uid);
      // Ook update: een cliënt die opnieuw koppelt met een nieuwe uitnodiging
      // van dezelfde begeleider, terwijl de oude koppeling nog bestaat. De
      // laatste voorwaarde (getAfter): de uitnodiging wordt in dezelfde batch
      // verbruikt, op naam van deze cliënt, zodat één uitnodiging maar één
      // koppeling oplevert.
      allow create, update: if request.auth != null
        && request.resource.data.clientUid == request.auth.uid
        && linkId == request.resource.data.coachUid + '_' + request.auth.uid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.coachUid
          == request.resource.data.coachUid
        && get(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == null
        && getAfter(/databases/$(database)/documents/invites/$(request.resource.data.inviteCode)).data.usedBy == request.auth.uid;
      allow delete: if request.auth != null
        && (resource.data.coachUid == request.auth.uid || resource.data.clientUid == request.auth.uid);
    }
  }
}
